#  LC 1. Two sum
#  https://leetcode.com/problems/two-sum/description/
# Approach: We use a hashmap. For each number, we check what number is needed to reach the target. If it is already in the map, we
# return the two indexes. Otherwise, we store the number and its index.
#  Time: O(n)
#  Space: O(n)
# Status: solved in 18 mins


class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:

        n = len(nums)

        for i in range(n):
            for j in range(i + 1, n):

                if nums[i] + nums[j] == target:
                    return [i, j]
